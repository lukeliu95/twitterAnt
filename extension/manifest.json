{
  "manifest_version": 3,
  "name": "Money Signal",
  "version": "0.1.0",
  "description": "从 Twitter 中发现赚钱机会",

  "permissions": [
    "storage",
    "sidePanel",
    "activeTab"
  ],

  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://api.money-signal.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["src/content/twitter-extractor.ts"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },

  "action": {
    "default_icon": {
      "16": "public/icon-16.png",
      "48": "public/icon-48.png",
      "128": "public/icon-128.png"
    }
  },

  "icons": {
    "16": "public/icon-16.png",
    "48": "public/icon-48.png",
    "128": "public/icon-128.png"
  }
}
